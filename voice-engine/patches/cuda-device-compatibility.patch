@@ -5242,3 +5242,13 @@ ggml_backend_t ggml_backend_cuda_init(int device) {
 }
 
 GGML_BACKEND_DL_IMPL(ggml_backend_cuda_reg)
+
+// Compile this probe with exactly the same architecture flags as GGML kernels.
+static __global__ void nv_compatibility_probe() {}
+bool ggml_backend_cuda_device_has_kernel(int device) {
+    if (cudaSetDevice(device) != cudaSuccess) return false;
+    cudaFuncAttributes attributes{};
+    const cudaError_t result = cudaFuncGetAttributes(&attributes, nv_compatibility_probe);
+    if (result != cudaSuccess) cudaGetLastError();
+    return result == cudaSuccess;
+}
