@@ -1,5 +1,7 @@
 #pragma once
 
+#include "ggml.h"
+
 #include <cstddef>
 #include <cstdint>
 #include <string>
@@ -13,6 +15,23 @@ namespace qwen3_tts {
 class TTSTransformer;
 namespace transformer_internal {
 
+// K-quant -> F32 copies fall back to CPU on CUDA. Keep quantized weights
+// native. CUDA F16 matvec also reads native weights, with F32 accumulation;
+// CPU/Vulkan floating-point behavior remains unchanged.
+inline ggml_tensor * project_ffn_down(ggml_context * ctx, ggml_tensor * weight, ggml_tensor * input) {
+#ifdef GGML_USE_CUDA
+    // Keep multi-token prefill on its original precision path. The native
+    // single-token CUDA kernel retains F32 activations and accumulation.
+    if (!ggml_is_quantized(weight->type) && input->ne[1] != 1)
+        weight = ggml_cast(ctx, weight, GGML_TYPE_F32);
+#else
+    if (!ggml_is_quantized(weight->type)) weight = ggml_cast(ctx, weight, GGML_TYPE_F32);
+#endif
+    auto * result = ggml_mul_mat(ctx, weight, input);
+    if (!ggml_is_quantized(weight->type)) ggml_mul_mat_set_prec(result, GGML_PREC_F32);
+    return result;
+}
